{
    "id": "widget-google-calendar",
    "name": "Google Calendar",
    "description": "Embedded Google Calendar iframe configured via environment variable.",
    "version": "1.0.0",
    "grid": {
        "default": { "w": 5, "h": 5 },
        "min":     { "w": 3, "h": 3 },
        "max":     { "w": 10, "h": 10 }
    },
    "settings": [],
    "refresh": { "default": 900, "min": 300, "max": 86400 },
    "requires": {
        "location": false,
        "api": ["/api/google_cal_url"],
        "env": ["GOOGLE_CAL_IFRAME_URL"]
    },
    "appearance": {
        "theme": false,
        "background": false,
        "text_color": false,
        "opacity": true,
        "blur": false,
        "border_radius": true,
        "border": false,
        "shadow": true,
        "font_family": false
    }
}
