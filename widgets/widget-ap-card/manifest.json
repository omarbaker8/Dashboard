{
    "id": "widget-ap-card",
    "name": "AP Card",
    "description": "AP News top stories as full-bleed image cards.",
    "version": "1.0.0",
    "grid": {
        "default": { "w": 4, "h": 4 },
        "min":     { "w": 3, "h": 3 },
        "max":     { "w": 8, "h": 8 }
    },
    "settings": [
        {
            "key": "session_interval",
            "type": "integer",
            "label": "Session Duration",
            "description": "How long stories accumulate before resetting",
            "default": 28800,
            "min": 60,
            "max": 86400
        }
    ],
    "refresh": { "default": 300, "min": 60, "max": 3600 },
    "requires": {
        "location": false,
        "api": ["/api/ap_cards"]
    },
    "appearance": {
        "theme": false,
        "background": false,
        "text_color": false,
        "opacity": true,
        "blur": false,
        "border_radius": true,
        "border": false,
        "shadow": true,
        "font_family": false
    }
}
