{
    "id": "widget-aljazeera-world-cup",
    "name": "Al Jazeera World Cup",
    "description": "Live match scores and recent results for the FIFA World Cup 2026.",
    "version": "1.0.0",
    "grid": {
        "default": { "w": 5, "h": 5 },
        "min":     { "w": 3, "h": 3 },
        "max":     { "w": 8, "h": 8 }
    },
    "settings": [
        {
            "key": "timezone",
            "type": "timezone",
            "label": "Timezone",
            "default": "Europe/Dublin"
        }
    ],
    "refresh": { "default": 60, "min": 60, "max": 300 },
    "requires": {
        "location": true,
        "api": ["/api/world_cup"]
    },
    "appearance": {
        "theme": false,
        "background": false,
        "text_color": false,
        "opacity": true,
        "blur": false,
        "border_radius": true,
        "border": false,
        "shadow": true,
        "font_family": false
    }
}
