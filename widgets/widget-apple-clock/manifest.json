{
    "id": "widget-apple-clock",
    "name": "Digital Clock",
    "description": "Large digital clock with date, time, and optional location label.",
    "version": "1.0.0",
    "grid": {
        "default": { "w": 3, "h": 3 },
        "min":     { "w": 2, "h": 2 },
        "max":     { "w": 6, "h": 6 }
    },
    "settings": [
        {
            "key": "timezone",
            "type": "timezone",
            "label": "Timezone",
            "default": "Europe/Dublin"
        },
        {
            "key": "city",
            "type": "string",
            "label": "City Label",
            "default": "Dublin",
            "maxLength": 40
        }
    ],
    "requires": {
        "location": true,
        "api": []
    },
    "appearance": {
        "theme": true,
        "background": true,
        "text_color": true,
        "opacity": true,
        "blur": true,
        "border_radius": true,
        "border": true,
        "shadow": true,
        "font_family": true
    }
}
