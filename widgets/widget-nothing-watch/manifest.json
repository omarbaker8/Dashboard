{
    "id": "widget-nothing-watch",
    "name": "Nothing Watch",
    "description": "Dot-matrix time display inspired by Nothing OS.",
    "version": "1.0.0",
    "grid": {
        "default": { "w": 3, "h": 3 },
        "min":     { "w": 2, "h": 2 },
        "max":     { "w": 6, "h": 6 },
        "lock_ratio": true
    },
    "settings": [
        {
            "key": "timezone",
            "type": "timezone",
            "label": "Timezone",
            "default": "Europe/Dublin"
        },
        {
            "key": "city",
            "type": "string",
            "label": "City Label",
            "default": "Dublin",
            "maxLength": 40
        }
    ],
    "requires": {
        "location": true,
        "api": []
    },
    "appearance": {
        "theme": false,
        "background": false,
        "text_color": false,
        "opacity": true,
        "blur": false,
        "border_radius": true,
        "border": false,
        "shadow": true,
        "font_family": false
    }
}
