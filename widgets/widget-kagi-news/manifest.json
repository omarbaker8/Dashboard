{
    "id": "widget-kagi-news",
    "name": "Kagi News",
    "description": "AI-curated news stories from Kagi by category: science, tech, AI, and more.",
    "version": "1.0.0",
    "grid": {
        "default": { "w": 4, "h": 4 },
        "min":     { "w": 3, "h": 3 },
        "max":     { "w": 8, "h": 8 }
    },
    "settings": [
        {
            "key": "categories",
            "type": "list",
            "label": "Categories",
            "description": "Comma-separated list of Kagi category IDs",
            "default": ["science", "tech", "ai"]
        }
    ],
    "refresh": { "default": 1800, "min": 300, "max": 86400 },
    "requires": {
        "location": false,
        "api": ["/api/kagi_stories"]
    },
    "appearance": {
        "theme": false,
        "background": false,
        "text_color": false,
        "opacity": true,
        "blur": false,
        "border_radius": true,
        "border": false,
        "shadow": true,
        "font_family": false
    }
}
