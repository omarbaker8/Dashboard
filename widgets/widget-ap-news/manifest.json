{
    "id": "widget-ap-news",
    "name": "AP News",
    "description": "AP News grouped by category: live blogs, world, politics, tech, and more.",
    "version": "1.0.0",
    "grid": {
        "default": { "w": 4, "h": 4 },
        "min":     { "w": 3, "h": 3 },
        "max":     { "w": 8, "h": 8 }
    },
    "settings": [
        {
            "key": "live_only",
            "type": "boolean",
            "label": "Live news only",
            "default": false
        },
        {
            "key": "session_interval",
            "type": "integer",
            "label": "Session Duration",
            "description": "How long stories accumulate before resetting",
            "default": 28800,
            "min": 60,
            "max": 86400
        }
    ],
    "refresh": { "default": 900, "min": 60, "max": 3600 },
    "requires": {
        "location": false,
        "api": ["/api/ap_news"]
    },
    "appearance": {
        "theme": true,
        "background": true,
        "text_color": true,
        "opacity": true,
        "blur": true,
        "border_radius": true,
        "border": true,
        "shadow": true,
        "font_family": true
    }
}
