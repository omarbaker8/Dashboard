{
    "id": "widget-apple-weather",
    "name": "Weather",
    "description": "Current conditions and hourly forecast via Open-Meteo (no API key required).",
    "version": "1.0.0",
    "grid": {
        "default": { "w": 2, "h": 2 },
        "min":     { "w": 2, "h": 2 },
        "max":     { "w": 6, "h": 6 }
    },
    "settings": [
        {
            "key": "timezone",
            "type": "timezone",
            "label": "Timezone",
            "default": "Europe/Dublin"
        },
        {
            "key": "city",
            "type": "string",
            "label": "City",
            "default": "Dublin",
            "maxLength": 40
        },
        {
            "key": "lat",
            "type": "latitude",
            "label": "Latitude",
            "default": 53.3498,
            "required": true
        },
        {
            "key": "lng",
            "type": "longitude",
            "label": "Longitude",
            "default": -6.2603,
            "required": true
        }
    ],
    "refresh": { "default": 900, "min": 300, "max": 86400 },
    "requires": {
        "location": true,
        "api": []
    },
    "appearance": {
        "theme": true,
        "background": true,
        "text_color": true,
        "opacity": true,
        "blur": true,
        "border_radius": true,
        "border": true,
        "shadow": true,
        "font_family": true
    }
}
